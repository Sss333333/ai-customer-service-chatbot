# Server Configuration
PORT=8080
PUBLIC_FRONTEND_URL=http://localhost:5173

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# PostgreSQL + pgvector (RAG Knowledge Base)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# S3 Configuration
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-southeast-2
LOCAL_DEV_MOCK_S3=true

# Voice Features (Optional: DashScope Paraformer ASR, Qwen TTS & Gemini Live Translation)
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-flash
DASHSCOPE_TTS_VOICE=longanhuan_v3.1
GEMINI_API_KEY=your-gemini-api-key-here

# Digital Human (In-process LAM ONNX Avatar)
LAM_ASSET_NAME=status.zip
# LAM_MODEL_PATH=assets/lam/lam_audio2exp.onnx
# LAM_MODEL_URL=https://github.com/Sss333333/ai-customer-service-chatbot/releases/download/models-v1/lam_audio2exp.onnx

# NetSuite Configuration (Supports both legacy & netsuite-mcp role-separated variables)
NETSUITE_ACCOUNT_ID=your-netsuite-account-id
NETSUITE_CONSUMER_KEY=your-netsuite-consumer-key
NETSUITE_CONSUMER_SECRET=your-netsuite-consumer-secret
NETSUITE_TOKEN_ID=your-netsuite-token-id
NETSUITE_TOKEN_SECRET=your-netsuite-token-secret
NETSUITE_TBA_TOKEN_ID_READ=your-netsuite-read-token-id
NETSUITE_TBA_TOKEN_SECRET_READ=your-netsuite-read-token-secret
NETSUITE_TBA_TOKEN_ID_WRITE=your-netsuite-write-token-id
NETSUITE_TBA_TOKEN_SECRET_WRITE=your-netsuite-write-token-secret
NETSUITE_CASE_FORM_ID=1
NETSUITE_STOCK_SCRIPT_ID=your-script-id
NETSUITE_STOCK_DEPLOY_ID=1
NETSUITE_DEFAULT_POSTCODE=2000
NETSUITE_DEFAULT_CUSTOMER_ID=1

# Optional: AWS Credentials for local development if not using ~/.aws/credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: Local HTTP proxy
# HTTPS_PROXY=http://127.0.0.1:7890

# Chat request timeout budget (ms)
CHAT_DEADLINE_MS=25000
